-- 35) Faded Gray: a gray cross + a round dot. The four lines fade in far from the dot, glide to their
-- spot near the dot over 5 seconds, fade out, then everything rests 3 seconds (only the dot shows). Repeats.
table.insert(Crosshairs, {
	Name = "Faded Gray",
	Build = function(holder)
		local GRAY = Color3.fromRGB(175, 175, 175)
		local MOVE = 5 -- seconds the lines take to glide
		local FADE = 1 -- seconds of fade in at the start and fade out at the end
		local COOLDOWN = 3 -- seconds with only the dot showing
		local CYCLE = MOVE + COOLDOWN
		local LEN, THICK = 9, 2 -- length / thickness of each line
		local HOME, OUTER = 6, 22 -- distance of a line's inner end from the dot: resting spot / far away spot
		local FROM_OUTSIDE = true -- true: lines appear far away and glide toward the dot. false: they start by the dot and glide out
		local startDist = FROM_OUTSIDE and OUTER or HOME
		local endDist = FROM_OUTSIDE and HOME or OUTER

		local right = bar(holder, 0, 0, LEN, THICK, GRAY)
		local left = bar(holder, 0, 0, LEN, THICK, GRAY)
		local down = bar(holder, 0, 0, THICK, LEN, GRAY)
		local up = bar(holder, 0, 0, THICK, LEN, GRAY)
		dot(holder, 6, Color3.fromRGB(205, 205, 205)) -- the round dot never moves or fades

		local start = os.clock()

		return function()
			local t = (os.clock() - start) % CYCLE
			local alpha, dist = 0, endDist
			if t < MOVE then
				local e = TweenService:GetValue(t / MOVE, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				dist = startDist + (endDist - startDist) * e
				alpha = math.clamp(math.min(t / FADE, (MOVE - t) / FADE), 0, 1)
			end

			local c = dist + LEN / 2
			right.Position = UDim2.new(0.5, c, 0.5, 0)
			left.Position = UDim2.new(0.5, -c, 0.5, 0)
			down.Position = UDim2.new(0.5, 0, 0.5, c)
			up.Position = UDim2.new(0.5, 0, 0.5, -c)

			local tr = 1 - alpha * 0.9
			right.BackgroundTransparency = tr
			left.BackgroundTransparency = tr
			down.BackgroundTransparency = tr
			up.BackgroundTransparency = tr
		end
	end,
})

-- 36) Monochrome: a black cross with a white rim. A white shine sweeps up through it (only inside the cross, like a clipping mask)
table.insert(Crosshairs, {
	Name = "Monochrome",
	Build = function(holder)
		local WHITE = Color3.new(1, 1, 1)
		local BLACK = Color3.new(0, 0, 0)
		local GAP, LEN = 4, 11 -- the cross arms run from 4 to 15 pixels away from the center
		local MID = GAP + LEN / 2
		local SWEEP, PAUSE = 1.1, 0.9 -- seconds the shine takes to travel up / rest before the next one
		local CYCLE = SWEEP + PAUSE
		local BAND = 6 -- how wide (in pixels) the shine is

		-- white rim behind everything (always visible, so the black cross can be seen on dark backgrounds)
		bar(holder, 0, -MID, 4, LEN + 2, WHITE)
		bar(holder, 0, MID, 4, LEN + 2, WHITE)
		bar(holder, -MID, 0, LEN + 2, 4, WHITE)
		bar(holder, MID, 0, LEN + 2, 4, WHITE)
		dot(holder, 7, WHITE)

		-- the black cross itself. The up/down arms are cut into thin slices so the shine can pass through them one slice at a time
		local slices = {}
		for _, sign in ipairs({ -1, 1 }) do
			for k = 0, LEN - 1 do
				local y = sign * (GAP + k + 0.5)
				slices[#slices + 1] = { frame = bar(holder, 0, y, 2, 1.6, BLACK), y = y }
			end
		end
		local sides = {
			bar(holder, -MID, 0, LEN, 2, BLACK),
			bar(holder, MID, 0, LEN, 2, BLACK),
			dot(holder, 5, BLACK),
		}

		local start = os.clock()

		local function level(y, bandY)
			local i = math.clamp(1 - math.abs(y - bandY) / BAND, 0, 1)
			return i ^ 1.3
		end

		return function()
			local t = (os.clock() - start) % CYCLE
			local bandY = 999 -- off screen while resting
			if t < SWEEP then
				local e = TweenService:GetValue(t / SWEEP, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
				bandY = 24 - 48 * e -- starts below the cross and travels up to above it
			end
			for _, s in ipairs(slices) do
				local v = level(s.y, bandY)
				s.frame.BackgroundColor3 = Color3.new(v, v, v)
			end
			local v = level(0, bandY)
			for _, f in ipairs(sides) do
				f.BackgroundColor3 = Color3.new(v, v, v)
			end
		end
	end,
})

-- 37) Ember Burst: orange sparks shoot out of the center, shrink and fade, over and over
table.insert(Crosshairs, {
	Name = "Ember Burst",
	Build = function(holder)
		local N = 10
		local sparks = {}
		for i = 1, N do
			local d = dot(holder, 3, Color3.fromRGB(255, 140 + (i % 3) * 25, 30))
			sparks[i] = { frame = d, angle = i * (2 * math.pi / N) + 0.3, offset = (i % 3) / 3 }
		end
		dot(holder, 3, Color3.fromRGB(255, 220, 140))

		return function(elapsed)
			for _, s in ipairs(sparks) do
				local p = (elapsed * 0.9 + s.offset) % 1
				local r = 3 + 22 * p ^ 0.7
				s.frame.Position = UDim2.new(0.5, math.cos(s.angle) * r, 0.5, math.sin(s.angle) * r)
				local size = 4 - 3 * p
				s.frame.Size = UDim2.fromOffset(size, size)
				s.frame.BackgroundTransparency = p ^ 2
			end
		end
	end,
})

-- 38) Shrinking Target: a big red ring closes in on the dot, flashes, then repeats
table.insert(Crosshairs, {
	Name = "Shrinking Target",
	Build = function(holder)
		local RED = Color3.fromRGB(255, 70, 70)
		local CLOSE, HOLD = 0.9, 0.5
		local CYCLE = CLOSE + HOLD

		local ring = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(44, 44),
			BackgroundTransparency = 1,
		}, { corner(100) })
		ring.Parent = holder
		local ringStroke = stroke(RED, 2, 0)
		ringStroke.Parent = ring

		bar(holder, 0, -13, 2, 5, RED)
		bar(holder, 0, 13, 2, 5, RED)
		bar(holder, -13, 0, 5, 2, RED)
		bar(holder, 13, 0, 5, 2, RED)
		dot(holder, 3, RED)

		local start = os.clock()

		return function()
			local t = (os.clock() - start) % CYCLE
			local size = 16
			local flash = 0
			if t < CLOSE then
				local e = TweenService:GetValue(t / CLOSE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				size = 44 - 28 * e
			else
				flash = 1 - (t - CLOSE) / HOLD
			end
			ring.Size = UDim2.fromOffset(size, size)
			ringStroke.Color = RED:Lerp(Color3.new(1, 1, 1), flash)
			ringStroke.Thickness = 2 + flash * 1.5
		end
	end,
})

