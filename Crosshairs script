-- 23) Azure Atom
table.insert(Crosshairs, {
Name = "Azure Atom",
Build = function(holder)
local AZURE = RGB(30, 150, 255)
local A, B = 17, 6.5
local SEGMENTS = 28
local orbitRot = { math.rad(0), math.rad(60), math.rad(120) }
local speeds = { 3.2, 2.7, 3.7 }
local phases = { 0, 2.1, 4.2 }
local function point(i, theta)
local x, y = A * math.cos(theta), B * math.sin(theta)
local c, s = math.cos(orbitRot[i]), math.sin(orbitRot[i])
return x * c - y * s, x * s + y * c
end
for i = 1, 3 do
for k = 0, SEGMENTS - 1 do
local x1, y1 = point(i, k / SEGMENTS * 2 * math.pi)
local x2, y2 = point(i, (k + 1) / SEGMENTS * 2 * math.pi)
local length = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2) + 0.5
local seg = bar(holder, (x1 + x2) / 2, (y1 + y2) / 2, length, 1, AZURE)
seg.Rotation = math.deg(math.atan2(y2 - y1, x2 - x1))
seg.BackgroundTransparency = 0.5
end
end
dot(holder, 5, RGB(120, 200, 255))
local bits = {}
for i = 1, 3 do
for tail = 0, 2 do
local d = dot(holder, 5 - tail * 1.2, AZURE)
d.BackgroundTransparency = tail * 0.3
bits[#bits + 1] = { frame = d, orbit = i, lag = tail * 0.2 }
end
end
return function(elapsed)
for _, b in ipairs(bits) do
local theta = elapsed * speeds[b.orbit] + phases[b.orbit] - b.lag
